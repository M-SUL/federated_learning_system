# The dataset is downloaded on first boot into a volume, not baked into the
# image: ~400 MB of licensed UCI data would bloat every layer.
gene+expression+cancer+rna+seq/
*.tar.gz

# Credentials must never enter the build context. The Dockerfile copies only
# named paths today, so nothing leaks -- but a later `COPY . .` would bake the
# password into a public image layer, where it is permanent.
.env
.env.*
!.env.example

.git/
.venv*/
**/__pycache__/
**/*.pyc
fl_rnaseq/notebooks/
fl_rnaseq/results/live/
claude-chat-history.tar.gz

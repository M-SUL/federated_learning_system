# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.idea/
# .vscode holds both shared project config and per-machine state. Track the
# three files a collaborator benefits from; ignore everything else in there.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace

# Claude Code per-machine state (.claude/settings.json IS shared; the local
# override and the transcript archives are not)
.claude/settings.local.json
.claude/*.local.json
claude-chat-history*


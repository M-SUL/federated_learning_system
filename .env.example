# Copy to .env and edit. .env is gitignored -- never commit real credentials.
DASHBOARD_USER=admin
# Required when ALLOW_LAUNCH=true. Generate one, do not invent one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_PASSWORD=
# false serves stored results read-only, with no way to start training.
ALLOW_LAUNCH=true
